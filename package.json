{
  "name": "module-10-quality-gates",
  "version": "1.0.0",
  "private": true,
  "description": "Prettier and ESLint quality gates before independent UI and API CI jobs",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint": "npm run lint:prettier && npm run lint:eslint",
    "format": "prettier --write .",
    "test:ui": "wdio run ./tests/config/wdio.conf.js",
    "test:api": "node --test tests/api/*.test.js",
    "test": "npm run test:api && npm run test:ui"
  },
  "devDependencies": {
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/globals": "9.31.3",
    "chai": "6.3.0",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "eslint-config-prettier": "10.1.8"
  }
}
