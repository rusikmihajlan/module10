pipeline {
    agent any

    triggers {
        cron('H */2 * * *')
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/module-10-quality-gates',
                    url: 'https://github.com/rusikmihajlan/module10.git'
            }
        }
        stage('Install dependencies') {
            steps {
                sh 'npm ci'
            }
        }
        stage('API tests') {
            steps {
                sh 'npm run test:api'
            }
        }
    }
}
