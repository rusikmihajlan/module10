pipeline {
    agent any

    triggers {
        cron('H */2 * * *')
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/module-10-quality-gates',
                    url: 'https://github.com/rusikmihajlan/module10.git'
            }
        }
        stage('Install dependencies') {
            steps {
                sh 'npm ci'
            }
        }
        stage('UI tests') {
            steps {
                sh 'npm run test:ui'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'artifacts/**/*.png', allowEmptyArchive: true
        }
    }
}
